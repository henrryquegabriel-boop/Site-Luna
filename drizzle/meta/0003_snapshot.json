          "autoincrement": false
        }
      },
      "name": "guest_invitations",
      "isExisting": false,
      "definition": "SELECT f.id AS ID_Convidado, f.head_name AS Nome_Chefe_Familia,\n  f.token AS Token_Unico,\n  MAX((SELECT COUNT(*) FROM invitation_members m WHERE m.family_id = f.id) - 1, 0) AS Limite_Acompanhantes,\n  CASE WHEN f.responded_at IS NULL THEN 'Pendente' ELSE 'Confirmado' END AS Status_Confirmacao\n  FROM invitation_families f"
    }
  },
